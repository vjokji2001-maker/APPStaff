{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter Web (Disable CORS)",
            "type": "dart",
            "request": "launch",
            "args": [
                "-d",
                "chrome",
                "--web-browser-flag",
                "--disable-web-security",
                "--web-browser-flag",
                "--user-data-dir=C:/Users/User/AppData/Local/Google/Chrome/User Data CORS"
            ]
        },
        {
            "name": "Flutter Web (Chrome)",
            "type": "dart",
            "request": "launch",
            "args": [
                "-d",
                "chrome"
            ]
        },
        {
            "name": "Flutter Android",
            "type": "dart",
            "request": "launch",
            "args": [
                "-d",
                "android"
            ]
        }
    ]
}